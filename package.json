{
  "$schema": "https://www.raycast.com/schemas/extension.json",
  "name": "my-raycast-utils",
  "title": "My Raycast Utils",
  "description": "My custom utilities",
  "icon": "search-svg-v3.png",
  "author": "1weiho",
  "contributors": [
    "ridemountainpig",
    "jolbol1"
  ],
  "categories": [
    "Design Tools",
    "Developer Tools",
    "Media"
  ],
  "license": "MIT",
  "commands": [
    {
      "name": "index",
      "title": "Search SVG Icons",
      "description": "Search SVG icons via svgl & local icons",
      "mode": "view",
      "icon": "search-svg-v3.png",
      "keywords": [
        "svg",
        "icon",
        "svgl",
        "local icons"
      ],
      "preferences": [
        {
          "name": "svgDefaultAction",
          "title": "SVG default Action",
          "description": "Default action for the SVG",
          "required": false,
          "type": "dropdown",
          "defaultValue": "copySvg",
          "data": [
            {
              "value": "copySvg",
              "title": "Copy SVG"
            },
            {
              "value": "copySvgFile",
              "title": "Copy SVG File"
            },
            {
              "value": "copySvgWordmark",
              "title": "Copy SVG Wordmark"
            },
            {
              "value": "copyPng",
              "title": "Copy PNG"
            },
            {
              "value": "operation",
              "title": "Operation"
            }
          ]
        },
        {
          "name": "defaultPngScale",
          "title": "Default PNG Scale",
          "description": "Default scale factor for PNG conversion",
          "type": "dropdown",
          "required": false,
          "defaultValue": "4",
          "data": [
            {
              "value": "1",
              "title": "1x"
            },
            {
              "value": "2",
              "title": "2x"
            },
            {
              "value": "4",
              "title": "4x"
            },
            {
              "value": "8",
              "title": "8x"
            },
            {
              "value": "16",
              "title": "16x"
            },
            {
              "value": "32",
              "title": "32x"
            },
            {
              "value": "64",
              "title": "64x"
            }
          ]
        },
        {
          "name": "localIconsPath",
          "title": "Local Icons Path",
          "description": "Folder of custom icons. Use a subfolder per icon (light.svg/dark.svg/wordmark-light.svg/wordmark-dark.svg) or flat files (figma.svg, figma-dark.svg, figma-wordmark.svg). ~ is supported.",
          "type": "textfield",
          "required": false,
          "placeholder": "~/Icons"
        },
        {
          "name": "defaultPackageManager",
          "title": "Default Package Manager",
          "description": "Default package manager",
          "type": "dropdown",
          "required": false,
          "data": [
            {
              "value": "pnpm",
              "title": "pnpm"
            },
            {
              "value": "npm",
              "title": "npm"
            },
            {
              "value": "yarn",
              "title": "yarn"
            },
            {
              "value": "bun",
              "title": "bun"
            }
          ]
        }
      ]
    },
    {
      "name": "convert-svg-to-png",
      "title": "Convert SVG to PNG",
      "description": "Convert an SVG file to PNG with custom scale",
      "mode": "no-view",
      "icon": "convert-svg-to-png-v2.png",
      "keywords": [
        "svg",
        "png",
        "convert",
        "scale",
        "image"
      ],
      "arguments": [
        {
          "name": "scale",
          "type": "dropdown",
          "placeholder": "Select scale (default: 4x)",
          "required": false,
          "data": [
            {
              "value": "1",
              "title": "1x"
            },
            {
              "value": "2",
              "title": "2x"
            },
            {
              "value": "4",
              "title": "4x"
            },
            {
              "value": "8",
              "title": "8x"
            },
            {
              "value": "16",
              "title": "16x"
            },
            {
              "value": "32",
              "title": "32x"
            },
            {
              "value": "64",
              "title": "64x"
            }
          ]
        }
      ]
    },
    {
      "name": "transcribe-video",
      "title": "Transcribe Video",
      "description": "Transcribe a video file from Finder or clipboard",
      "mode": "no-view",
      "icon": "transcribe-video-v2.png",
      "keywords": [
        "transcribe",
        "video",
        "audio",
        "speech"
      ]
    },
    {
      "name": "delay-audio",
      "title": "Delay Audio",
      "description": "Delay audio in a video or audio file",
      "mode": "no-view",
      "icon": "delay-audio-v2.png",
      "keywords": [
        "delay",
        "audio",
        "sync",
        "offset"
      ],
      "arguments": [
        {
          "name": "delay",
          "type": "text",
          "placeholder": "Delay in milliseconds (default: 50)",
          "required": false
        }
      ]
    },
    {
      "name": "remove-background",
      "title": "Remove Image Background",
      "description": "Remove background from an image in Finder or clipboard",
      "mode": "no-view",
      "keywords": [
        "background",
        "remove",
        "image",
        "fal-ai"
      ],
      "icon": "remove-background-v2.png",
      "arguments": [
        {
          "name": "model",
          "type": "dropdown",
          "placeholder": "Select model",
          "required": false,
          "data": [
            {
              "value": "fal-ai/bria/background/remove",
              "title": "FAL AI (Online)"
            },
            {
              "value": "offline",
              "title": "Offline"
            }
          ]
        },
        {
          "name": "customModel",
          "type": "text",
          "placeholder": "Custom model name (optional)",
          "required": false
        }
      ],
      "preferences": [
        {
          "name": "falApiKey",
          "title": "FAL API Key",
          "description": "API key for fal-ai background removal service",
          "type": "password",
          "required": false,
          "placeholder": "Enter your fal-ai API key"
        },
        {
          "name": "defaultModel",
          "title": "Default Model",
          "description": "Default model to use when dropdown is not selected",
          "type": "dropdown",
          "required": false,
          "data": [
            {
              "value": "fal-ai/bria/background/remove",
              "title": "FAL AI (Online)"
            },
            {
              "value": "offline",
              "title": "Offline"
            }
          ]
        }
      ]
    },
    {
      "name": "mise-registry",
      "title": "Search Mise Registry",
      "description": "Search the mise registry and install tools globally with mise use -g",
      "mode": "view",
      "icon": "mise-registry-v2.png",
      "keywords": [
        "mise",
        "registry",
        "tool",
        "install",
        "version",
        "runtime"
      ]
    },
    {
      "name": "mise-tools",
      "title": "Manage Mise Tools",
      "description": "List, upgrade and remove your globally installed mise tools",
      "mode": "view",
      "icon": "mise-tools-v2.png",
      "keywords": [
        "mise",
        "tools",
        "global",
        "upgrade",
        "outdated",
        "uninstall"
      ]
    },
    {
      "name": "download-video",
      "title": "Download Video",
      "description": "Download a video, or just its audio, with yt-dlp",
      "mode": "view",
      "icon": "download-video-v3.png",
      "keywords": [
        "youtube",
        "yt-dlp",
        "video",
        "download",
        "mp3",
        "audio"
      ]
    },
    {
      "name": "download-thumbnail",
      "title": "Download Video Thumbnail",
      "description": "Browse every thumbnail a video publishes and download the one you want",
      "mode": "view",
      "icon": "download-thumbnail-v3.png",
      "keywords": [
        "youtube",
        "thumbnail",
        "cover",
        "poster",
        "image"
      ]
    },
    {
      "name": "video-transcript",
      "title": "Get Video Transcript",
      "description": "Read, copy and save the subtitles of a video",
      "mode": "view",
      "icon": "video-transcript-v2.png",
      "keywords": [
        "youtube",
        "transcript",
        "subtitles",
        "captions",
        "srt"
      ]
    },
    {
      "name": "video-info",
      "title": "Show Video Info",
      "description": "Show the metadata of a video: channel, duration, views, chapters and formats",
      "mode": "view",
      "icon": "video-info-v2.png",
      "keywords": [
        "youtube",
        "metadata",
        "info",
        "chapters",
        "views"
      ]
    }
  ],
  "preferences": [
    {
      "name": "misePath",
      "title": "Mise Binary Path",
      "description": "Path to the mise binary. Leave empty to detect it automatically.",
      "type": "textfield",
      "required": false,
      "placeholder": "/opt/homebrew/bin/mise"
    },
    {
      "name": "videoDownloadPath",
      "title": "Video Download Path",
      "description": "Where downloaded videos, thumbnails and transcripts are saved.",
      "type": "directory",
      "default": "~/Downloads",
      "required": false
    },
    {
      "name": "ytDlpPath",
      "title": "yt-dlp Path",
      "description": "Path to the yt-dlp binary. Leave empty to detect it automatically.",
      "type": "textfield",
      "required": false,
      "placeholder": "/opt/homebrew/bin/yt-dlp"
    },
    {
      "name": "ffmpegPath",
      "title": "ffmpeg Path",
      "description": "Path to the ffmpeg binary, used to merge, recode and extract audio. Leave empty to detect it automatically.",
      "type": "textfield",
      "required": false,
      "placeholder": "/opt/homebrew/bin/ffmpeg"
    },
    {
      "name": "autoLoadVideoUrl",
      "title": "Auto-Load Video URL",
      "description": "Where the video commands take their URL from when they open.",
      "type": "dropdown",
      "required": false,
      "default": "clipboard",
      "data": [
        {
          "title": "Clipboard",
          "value": "clipboard"
        },
        {
          "title": "Selected Text",
          "value": "selection"
        },
        {
          "title": "Active Browser Tab",
          "value": "browser"
        },
        {
          "title": "Nothing",
          "value": "none"
        }
      ]
    },
    {
      "name": "forceIpv4",
      "title": "Force IPv4",
      "description": "Route yt-dlp over IPv4. Helps when downloads fail with bot-check or 403 errors.",
      "type": "checkbox",
      "label": "Force IPv4 for yt-dlp",
      "default": false,
      "required": false
    },
    {
      "name": "cookiesFromBrowser",
      "title": "Use Cookies from Browser",
      "description": "Pass your logged-in browser cookies to yt-dlp, for age-restricted or members-only media.",
      "type": "dropdown",
      "required": false,
      "default": "none",
      "data": [
        {
          "title": "None",
          "value": "none"
        },
        {
          "title": "Safari",
          "value": "safari"
        },
        {
          "title": "Chrome",
          "value": "chrome"
        },
        {
          "title": "Brave",
          "value": "brave"
        },
        {
          "title": "Microsoft Edge",
          "value": "edge"
        },
        {
          "title": "Firefox",
          "value": "firefox"
        },
        {
          "title": "Arc",
          "value": "arc"
        },
        {
          "title": "Vivaldi",
          "value": "vivaldi"
        }
      ]
    }
  ],
  "dependencies": {
    "@fal-ai/client": "^1.10.1",
    "@raycast/api": "^1.104.24",
    "execa": "^10.0.1"
  },
  "devDependencies": {
    "@raycast/eslint-config": "^2.2.0",
    "@types/node": "22.19.17",
    "@types/react": "19.0.10",
    "eslint": "^10.8.0",
    "prettier": "^3.9.6",
    "react-devtools": "6.1.1",
    "typescript": "^6.0.3"
  },
  "scripts": {
    "build": "ray build -e dist",
    "dev": "ray develop",
    "fix-lint": "ray lint --fix",
    "lint": "ray lint",
    "publish": "pnpm dlx @raycast/api@latest publish"
  },
  "platforms": [
    "macOS"
  ],
  "packageManager": "pnpm@11.21.0"
}
