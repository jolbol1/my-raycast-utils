{
  "$schema": "https://www.raycast.com/schemas/extension.json",
  "name": "my-utils",
  "title": "My Utils",
  "description": "My custom utilities",
  "icon": "command-icon.png",
  "author": "1weiho",
  "contributors": [
    "ridemountainpig",
    "jolbol1"
  ],
  "categories": [
    "Design Tools",
    "Developer Tools"
  ],
  "license": "MIT",
  "commands": [
    {
      "name": "index",
      "title": "Search SVG Icons",
      "description": "Search SVG icons via svgl & local icons",
      "mode": "view",
      "keywords": [
        "svg",
        "icon",
        "svgl",
        "local icons"
      ],
      "preferences": [
        {
          "name": "svgDefaultAction",
          "title": "SVG default Action",
          "description": "Default action for the SVG",
          "required": false,
          "type": "dropdown",
          "defaultValue": "copySvg",
          "data": [
            {
              "value": "copySvg",
              "title": "Copy SVG"
            },
            {
              "value": "copySvgFile",
              "title": "Copy SVG File"
            },
            {
              "value": "copySvgWordmark",
              "title": "Copy SVG Wordmark"
            },
            {
              "value": "copyPng",
              "title": "Copy PNG"
            },
            {
              "value": "operation",
              "title": "Operation"
            }
          ]
        },
        {
          "name": "defaultPngScale",
          "title": "Default PNG Scale",
          "description": "Default scale factor for PNG conversion",
          "type": "dropdown",
          "required": false,
          "defaultValue": "4",
          "data": [
            {
              "value": "1",
              "title": "1x"
            },
            {
              "value": "2",
              "title": "2x"
            },
            {
              "value": "4",
              "title": "4x"
            },
            {
              "value": "8",
              "title": "8x"
            },
            {
              "value": "16",
              "title": "16x"
            },
            {
              "value": "32",
              "title": "32x"
            },
            {
              "value": "64",
              "title": "64x"
            }
          ]
        },
        {
          "name": "localIconsPath",
          "title": "Local Icons Path",
          "description": "Path to local icons folder (optional)",
          "type": "textfield",
          "required": false,
          "placeholder": "/Users/username/path/to/icons"
        },
        {
          "name": "defaultPackageManager",
          "title": "Default Package Manager",
          "description": "Default package manager",
          "type": "dropdown",
          "required": false,
          "data": [
            {
              "value": "pnpm",
              "title": "pnpm"
            },
            {
              "value": "npm",
              "title": "npm"
            },
            {
              "value": "yarn",
              "title": "yarn"
            },
            {
              "value": "bun",
              "title": "bun"
            }
          ]
        }
      ]
    },
    {
      "name": "convert-svg-to-png",
      "title": "Convert SVG to PNG",
      "description": "Convert an SVG file to PNG with custom scale",
      "mode": "no-view",
      "icon": "command-icon.png",
      "keywords": [
        "svg",
        "png",
        "convert",
        "scale",
        "image"
      ],
      "arguments": [
        {
          "name": "scale",
          "type": "dropdown",
          "placeholder": "Select scale (default: 4x)",
          "required": false,
          "data": [
            {
              "value": "1",
              "title": "1x"
            },
            {
              "value": "2",
              "title": "2x"
            },
            {
              "value": "4",
              "title": "4x"
            },
            {
              "value": "8",
              "title": "8x"
            },
            {
              "value": "16",
              "title": "16x"
            },
            {
              "value": "32",
              "title": "32x"
            },
            {
              "value": "64",
              "title": "64x"
            }
          ]
        }
      ]
    },
    {
      "name": "transcribe-video",
      "title": "Transcribe Video",
      "description": "Transcribe a video file from Finder or clipboard",
      "mode": "no-view",
      "icon": "transcribe-command.png",
      "keywords": [
        "transcribe",
        "video",
        "audio",
        "speech"
      ]
    },
    {
      "name": "delay-audio",
      "title": "Delay Audio",
      "description": "Delay audio in a video or audio file",
      "mode": "no-view",
      "icon": "delay-command.png",
      "keywords": [
        "delay",
        "audio",
        "sync",
        "offset"
      ],
      "arguments": [
        {
          "name": "delay",
          "type": "text",
          "placeholder": "Delay in milliseconds (default: 50)",
          "required": false
        }
      ]
    },
    {
      "name": "remove-background",
      "title": "Remove Image Background",
      "description": "Remove background from an image in Finder or clipboard",
      "mode": "no-view",
      "keywords": [
        "background",
        "remove",
        "image",
        "fal-ai"
      ],
      "icon": "remove-command.png",
      "arguments": [
        {
          "name": "model",
          "type": "dropdown",
          "placeholder": "Select model",
          "required": false,
          "data": [
            {
              "value": "fal-ai/bria/background/remove",
              "title": "FAL AI (Online)"
            },
            {
              "value": "offline",
              "title": "Offline"
            }
          ]
        },
        {
          "name": "customModel",
          "type": "text",
          "placeholder": "Custom model name (optional)",
          "required": false
        }
      ],
      "preferences": [
        {
          "name": "falApiKey",
          "title": "FAL API Key",
          "description": "API key for fal-ai background removal service",
          "type": "password",
          "required": false,
          "placeholder": "Enter your fal-ai API key"
        },
        {
          "name": "defaultModel",
          "title": "Default Model",
          "description": "Default model to use when dropdown is not selected",
          "type": "dropdown",
          "required": false,
          "data": [
            {
              "value": "fal-ai/bria/background/remove",
              "title": "FAL AI (Online)"
            },
            {
              "value": "offline",
              "title": "Offline"
            }
          ]
        }
      ]
    }
  ],
  "dependencies": {
    "@fal-ai/client": "^1.6.2",
    "@raycast/api": "^1.93.0",
    "@raycast/utils": "^1.14.0",
    "dedent": "^1.5.3",
    "execa": "^8.0.1",
    "node-fetch": "^3.3.2"
  },
  "devDependencies": {
    "@raycast/eslint-config": "^1.0.6",
    "@types/node": "20.8.10",
    "@types/react": "^18.3.3",
    "eslint": "^8.51.0",
    "prettier": "^3.0.3",
    "react-devtools": "^5.2.0",
    "typescript": "^5.2.2"
  },
  "scripts": {
    "build": "ray build -e dist",
    "dev": "ray develop",
    "fix-lint": "ray lint --fix",
    "lint": "ray lint",
    "publish": "npx @raycast/api@latest publish"
  },
  "platforms": [
    "macOS",
    "Windows"
  ]
}
